{
  "expo": {
    "name": "GuguGaga AI VTuber",
    "slug": "gugu-ai-vtuber",
    "version": "2.6.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6366f1"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gugu.ai-vtuber",
      "buildNumber": "2",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "需要麦克风权限来进行语音输入",
        "NSSpeechRecognitionUsageDescription": "需要语音识别权限来将语音转换为文字"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6366f1"
      },
      "package": "com.gugu.aivtuber",
      "versionCode": 2,
      "permissions": [
        "INTERNET",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": ["expo-router"],
    "updates": {
      "url": "https://u.expo.dev/dda9f774-0ed6-416e-80a8-051d457990f3",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "router": { "origin": false },
      "eas": { "projectId": "dda9f774-0ed6-416e-80a8-051d457990f3" }
    },
    "owner": "xzt238",
    "runtimeVersion": "2.0.0"
  }
}
