    "expo-modules-autolinking": "^1.10.3",
    "expo-modules-core": "^1.11.14",
    "expo-router": "~3.5.24",
    "expo-speech": "~12.0.2",
    "expo-splash-screen": "~0.27.7",
    "expo-status-bar": "~1.12.1",
    "expo-updates": "~0.25.28",
